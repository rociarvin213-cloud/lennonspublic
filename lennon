-- FREE CAM TOGGLE
-- ============================================================
local function disableFreecam()
	freecamActive = false
	if freecamRender then freecamRender:Disconnect(); freecamRender = nil end
	Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.Anchored = false end
	btnFreecam.BackgroundColor3 = COR_BOTAO_DESATIVADO
	btnFreecam.Text = "Free Cam: OFF"
end

local function enableFreecam()
	local activeCamera = Workspace.CurrentCamera
	freecamActive  = true
	cameraCFrame   = activeCamera.CFrame
	local lv       = cameraCFrame.LookVector
	rotationX      = math.atan2(-lv.X, -lv.Z)
	rotationY      = math.asin(math.clamp(lv.Y, -1, 1))
	activeCamera.CameraType = Enum.CameraType.Scriptable
	local char = player.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.Anchored = true end
	btnFreecam.BackgroundColor3 = COR_BOTAO_ATIVO
	btnFreecam.Text = "Free Cam: ON"

	freecamRender = RunService.RenderStepped:Connect(function()
		local currentSpeed  = freecamSpeed
		local moveVector    = Controls:GetMoveVector()
		local forwardVector = cameraCFrame.LookVector
		local rightVector   = cameraCFrame.RightVector
		local moveDirection = Vector3.new()
		if moveVector.Magnitude > 0 then
			moveDirection = (forwardVector * -moveVector.Z) + (rightVector * moveVector.X)
		end
		if moveDirection.Magnitude > 0 then
			moveDirection = moveDirection.Unit * currentSpeed
		end
		cameraCFrame = cameraCFrame + moveDirection
		Workspace.CurrentCamera.CFrame = cameraCFrame
	end)
end

btnFreecam.MouseButton1Click:Connect(function()
	if freecamActive then disableFreecam() else enableFreecam() end
end)

UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if not freecamActive or gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta       = input.Delta
		local sensitivity = input.UserInputType == Enum.UserInputType.Touch and TOUCH_SENSITIVITY or MOUSE_SENSITIVITY
		rotationX = rotationX - (delta.X * (sensitivity / 100))
		rotationY = math.clamp(rotationY - (delta.Y * (sensitivity / 100)), -math.rad(82), math.rad(82))
		cameraCFrame = CFrame.new(cameraCFrame.Position) * CFrame.Angles(0, rotationX, 0) * CFrame.Angles(rotationY, 0, 0)
		Workspace.CurrentCamera.CFrame = cameraCFrame
	end
end)

