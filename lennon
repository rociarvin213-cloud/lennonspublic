local allDraggables = {}  -- track all draggable frames for lock
local uiLocked = false   -- forward-declared; set properly after buttons are wired

local function makeDraggable(frame)
	local dragging, dragStart, startPos = false, nil, nil

	local conn1 = frame.InputBegan:Connect(function(input)
		if uiLocked then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging  = true
			dragStart = input.Position
			startPos  = frame.Position
		end
	end)
	local conn2 = UserInputService.InputChanged:Connect(function(input)
		if uiLocked then dragging = false return end
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	local conn3 = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				saveSettings()
			end
		end
	end)

	local entry = {frame = frame, enabled = true, conns = {conn1, conn2, conn3}}
	table.insert(allDraggables, entry)
	return entry
end

