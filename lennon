local function UpdateESPFrame()
	local currentCamera = Workspace.CurrentCamera
	if not currentCamera then return end

	updateDetectedTiers()

	if SavedSettings.EspEnabled then
		local mapFolder        = Workspace:FindFirstChild("Map")
		local generatorsFolder = mapFolder and mapFolder:FindFirstChild("Generators")
		local generators       = generatorsFolder and generatorsFolder:GetChildren() or {}
		local rawPoints        = {}

		for _, gen in pairs(generators) do
			if gen:IsA("Model") or gen:IsA("BasePart") then
				local part = gen:IsA("BasePart") and gen or gen.PrimaryPart or gen:FindFirstChildWhichIsA("BasePart")
				if part then
					local tier = getGeneratorTier(gen)
					if SavedSettings.TierFilters[tier] ~= false then
						local screenPos, onScreen = currentCamera:WorldToViewportPoint(part.Position + Vector3.new(0, 1.8, 0))
						if onScreen then
							table.insert(rawPoints, {tier = tier, x = screenPos.X, y = screenPos.Y, depth = screenPos.Z})
						end
					end
				end
			end
		end

		local screenClusters = {}
		for _, pt in ipairs(rawPoints) do
			local matched = false
			for _, cluster in ipairs(screenClusters) do
				if cluster.tier == pt.tier then
					local dist = math.sqrt((cluster.x - pt.x)^2 + (cluster.y - pt.y)^2)
					if dist <= SCREEN_COMBINE_RADIUS then
						cluster.count = cluster.count + 1
						cluster.x     = (cluster.x * (cluster.count - 1) + pt.x) / cluster.count
						cluster.y     = (cluster.y * (cluster.count - 1) + pt.y) / cluster.count
						cluster.depth = math.min(cluster.depth, pt.depth)
						matched = true; break
					end
				end
			end
			if not matched then
				table.insert(screenClusters, {tier = pt.tier, x = pt.x, y = pt.y, depth = pt.depth, count = 1, width = s(140), height = s(16)})
			end
		end

		table.sort(screenClusters, function(a, b) return a.depth < b.depth end)

		for i = 1, #screenClusters do
			local current = screenClusters[i]
			for j = 1, i - 1 do
				local existing = screenClusters[j]
				local hOverlap = math.abs(current.x - existing.x) < ((current.width + existing.width) / 2)
				local vOverlap = math.abs(current.y - existing.y) < current.height
				if hOverlap and vOverlap then
					current.y = existing.y - current.height - VERTICAL_PADDING
				end
			end
		end

		for _, label in pairs(genPool) do label.Visible = false end
		for idx, cluster in ipairs(screenClusters) do
			local uiLabel = GetOrCreateGenLabel(idx)
			uiLabel.Text       = (cluster.count > 1) and (cluster.tier .. " x" .. cluster.count) or cluster.tier
			uiLabel.TextColor3 = getTierColor(cluster.tier)
			uiLabel.Position   = UDim2.new(0, cluster.x - (cluster.width / 2), 0, cluster.y - (cluster.height / 2))
			uiLabel.Visible    = true
		end
	else
		for _, label in pairs(genPool) do label.Visible = false end
	end

	if SavedSettings.PlayerEspEnabled then
		for _, label in pairs(playerPool) do label.Visible = false end
		local playerIdx     = 1
		local activePlayers = Players:GetPlayers()
		for i = 1, #activePlayers do
			local p = activePlayers[i]
			if p ~= player and p.Character then
				local head = p.Character:FindFirstChild("Head")
				if head then
					local screenPos, onScreen = currentCamera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
					if onScreen then
						local pLabel    = GetOrCreatePlayerLabel(playerIdx)
						pLabel.Text     = p.DisplayName or p.Name
						pLabel.Position = UDim2.new(0, screenPos.X - s(70), 0, screenPos.Y - s(8))
						pLabel.Visible  = true
						playerIdx       = playerIdx + 1
					end
				end
			end
		end
	else
		for _, label in pairs(playerPool) do label.Visible = false end
	end
end

