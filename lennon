local function updateDetectedTiers()
	local newTiers = detectTiers()
	local changed  = false
	for tier, _ in pairs(newTiers) do
		if not detectedTiers[tier] then
			detectedTiers[tier] = true
			if SavedSettings.TierFilters[tier] == nil then
				SavedSettings.TierFilters[tier] = true
			end
			changed = true
		end
	end
	if changed then
		for _, callback in ipairs(tierFilterCallbacks) do callback() end
	end
	return changed
end

