local function loadSettings()
	if isfile and isfile(SETTINGS_FILE) then
		local success, result = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
		if success and type(result) == "table" then
			for k, v in pairs(result) do
				if k == "TierFilters" and type(v) == "table" then
					for savedTier, savedState in pairs(v) do
						SavedSettings.TierFilters[savedTier] = savedState
					end
				else
					SavedSettings[k] = v
				end
			end
		end
	end
end

