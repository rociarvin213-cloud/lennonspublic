local camera = Workspace.CurrentCamera
local function getScale()
	local vp = camera.ViewportSize
	-- Base design at 1280x720 so UI is naturally larger on typical screens
	local scaleX = vp.X / 1280
	local scaleY = vp.Y / 720
	local sc = math.clamp(math.min(scaleX, scaleY), 0.75, 1.4)
	return sc
end

