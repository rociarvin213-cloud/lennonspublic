local function createTPActionBtn(name, text, defPos, dirKey)
	local btn = Instance.new("TextButton", mlGui)
	btn.Name             = name
	btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	btn.BackgroundTransparency = 0.2
	btn.Size             = UDim2.new(0, s(58), 0, s(58))
	btn.Position         = defPos
	btn.Font             = Enum.Font.Arcade
	btn.Text             = text
	btn.TextColor3       = COR_TEXTO
	btn.TextSize         = s(11)
	btn.TextWrapped      = true
	btn.Visible          = true   -- FIX: always visible
	mkCorner(btn, s(12))

	local UIStroke2 = Instance.new("UIStroke")
	UIStroke2.Color      = COR_BOTAO_ATIVO
	UIStroke2.Thickness  = 1
	UIStroke2.Transparency = 0.85
	UIStroke2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	UIStroke2.Parent     = btn

	-- drag + click separation
	local dragging2, dragStart2, startPos2, draggedFar2 = false, nil, nil, false
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging2   = true
			draggedFar2 = false
			dragStart2  = input.Position
			startPos2   = btn.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging2 and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			if uiLocked then dragging2 = false return end  -- FIX: respect lock
			local delta = input.Position - dragStart2
			if delta.Magnitude > 5 then draggedFar2 = true end
			btn.Position = UDim2.new(startPos2.X.Scale, startPos2.X.Offset + delta.X, startPos2.Y.Scale, startPos2.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging2 then
				dragging2 = false
				if not draggedFar2 then
					-- FIX: actually teleport player
					local char = player.Character
					local hrp  = char and char:FindFirstChild("HumanoidRootPart")
					if hrp then
						local amt = tpAmounts[dirKey]
						if dirKey == "Forward" then
							hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -amt)
						elseif dirKey == "Up" then
							hrp.CFrame = hrp.CFrame * CFrame.new(0, amt, 0)
						elseif dirKey == "Down" then
							hrp.CFrame = hrp.CFrame * CFrame.new(0, -amt, 0)
						end
					end
				else
					-- Dragged: save new button position
					saveSettings()
				end
			end
		end
	end)

	return btn
end

