local function getGeneratorTier(instance)
	local rawText   = "Unknown"
	local textLabel = instance:FindFirstChildWhichIsA("TextLabel", true) or instance:FindFirstChildWhichIsA("TextButton", true)
	if textLabel and textLabel.Text ~= "" and not string.find(textLabel.Text:lower(), "drop") then
		rawText = textLabel.Text:gsub("\n", " "):match("^%s*(.-)%s*$")
	end
	if rawText == "Unknown" then
		for _, obj in pairs(instance:GetDescendants()) do
			if obj:IsA("StringValue") and (obj.Name:lower():find("tier") or obj.Name:lower():find("name")) then
				rawText = obj.Value; break
			end
		end
	end
	if rawText == "Unknown" then rawText = instance.Name end
	local cleanedText = rawText:gsub("%s*[Gg]enerator%s*", ""):match("^%s*(.-)%s*$")
	return cleanedText ~= "" and cleanedText or "Basic"
end

local function getTierColor(tierName)
	local lower = tierName:lower()
	if string.find(lower, "basic")   then return Color3.fromRGB(255, 255, 255)
	elseif string.find(lower, "uncommon") or string.find(lower, "common") then return Color3.fromRGB(0, 255, 150)
	elseif string.find(lower, "rare") or string.find(lower, "epic")       then return Color3.fromRGB(0, 180, 255)
	elseif string.find(lower, "legendary") or string.find(lower, "mythical") then return Color3.fromRGB(255, 180, 0)
	else return Color3.fromRGB(255, 50, 255) end
end

local function detectTiers()
	local mapFolder        = Workspace:FindFirstChild("Map")
	local generatorsFolder = mapFolder and mapFolder:FindFirstChild("Generators")
	local generators       = generatorsFolder and generatorsFolder:GetChildren() or {}
	local foundTiers = {}
	for _, gen in pairs(generators) do
		if gen:IsA("Model") or gen:IsA("BasePart") then
			local tier = getGeneratorTier(gen)
			foundTiers[tier] = true
		end
	end
	return foundTiers
end

