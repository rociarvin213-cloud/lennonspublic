local function mkTPRow(parent, y, label, dirKey)
	local lbl = Instance.new("TextLabel", parent)
	lbl.Size             = UDim2.new(0, s(110), 0, ROW_H)
	lbl.Position         = UDim2.new(0, MARGEM, 0, y)
	lbl.Text             = label
	lbl.TextSize         = s(10)
	lbl.Font             = Enum.Font.Arcade
	lbl.TextColor3       = COR_TEXTO
	lbl.TextXAlignment   = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1

	local BOX_W = s(50)
	local box = Instance.new("TextBox", parent)
	box.Size             = UDim2.new(0, BOX_W, 0, ROW_H - s(4))
	box.Position         = UDim2.new(1, -MARGEM - BOX_W, 0, y + s(2))
	box.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	box.BorderSizePixel  = 0
	box.Text             = tostring(tpAmounts[dirKey])
	box.TextSize         = s(12)
	box.Font             = Enum.Font.Arcade
	box.TextColor3       = COR_TEXTO
	box.ClearTextOnFocus = false
	mkCorner(box, s(6)); mkStroke(box)

	-- Commit helper — called from both FocusLost and ReturnPressed
	local function commitValue()
		local raw = (box.Text or ""):gsub(",", "."):match("^%s*(.-)%s*$")
		local v = tonumber(raw)
		if v and v > 0 and v <= 10000 then
			tpAmounts[dirKey] = v
		end
		box.Text = tostring(tpAmounts[dirKey])
	end

	box.FocusLost:Connect(function(_enterPressed)
		commitValue()
	end)
	-- Also commit on Return key for keyboard users
	box:GetPropertyChangedSignal("Text"):Connect(function()
		-- Only auto-commit when text ends with newline (Return pressed)
		if box.Text:find("\n") then
			box.Text = box.Text:gsub("\n", "")
			commitValue()
		end
	end)
end

